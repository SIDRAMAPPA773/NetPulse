PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/network_monitor
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Legacy-mode allowlist for monitoring. Application-managed authorization uses
# approved private subnet records instead; this remains enforced in legacy mode.
# An empty value never grants unrestricted access.
MONITORING_TARGET_ALLOWLIST=
# Legacy-mode exact CIDR allowlist for discovery. Application-managed mode uses
# active, approved subnet records instead. Discovery still requires an explicit
# admin action or schedule in either mode.
DISCOVERY_ALLOWLIST=
# Discovery is capped at concurrency 4 and 4 probe starts per second.
DISCOVERY_MAX_CONCURRENCY=2
DISCOVERY_MAX_PROBES_PER_SECOND=2
# Server-side clamps concurrency to 1-10 and probe starts to 1-10 per second.
MONITORING_MAX_CONCURRENCY=5
MONITORING_MAX_PROBES_PER_SECOND=5
